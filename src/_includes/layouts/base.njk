<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% set postBodyHtml = content.split('<div class="blog-post-body">')[1].split('<div class="blog-share-bar">')[0] if pageClass == "page-blog-post" and '<div class="blog-post-body">' in content else "" %}
  {% set metaDescription = description or (postBodyHtml | excerpt(155) if postBodyHtml else "Lunar Light Awakening in Schofield, WI offers stones, crystals, jewelry, herbal products, classes, workshops, and holistic practitioner services.") %}
  <meta name="description" content="{{ metaDescription }}">
  <title>{% if pageClass == "page-blog-post" and title %}{{ title }} | Lunar Light Awakening{% else %}{{ title | default("Lunar Light Awakening") }}{% endif %}</title>
  <link rel="icon" sizes="48x48" href="{{ site.favicon | default('/images/LogoMoon.webp') }}">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <header class="site-header">
    <div class="logo-container">
      <a href="/">
        <img src="{{ site.logo | default('/images/LunaLandscape.jpg') }}" alt="{{ site.logoAlt | default('Lunar Light Awakening Logo') }}" class="site-logo">
      </a>
    </div>

    <div class="nav-toggle-wrap">
      <button type="button" class="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="site-nav">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>

    <nav id="site-nav" class="site-nav">
      <a href="/" class="{% if page.url == '/' %}active{% endif %}">Home</a>
      <a href="/merchandise/" class="{% if page.url == '/merchandise/' %}active{% endif %}">Merchandise</a>
      <a href="/events-and-classes/" class="{% if page.url == '/events-and-classes/' %}active{% endif %}">Events &amp; Classes</a>
      <a href="/practitioner-services/" class="{% if page.url == '/practitioner-services/' %}active{% endif %}">Practitioner Services</a>
      <a href="/blog/" class="{% if page.url and page.url.startsWith('/blog/') %}active{% endif %}">Blog</a>
    </nav>
  </header>

  <main class="site-main{% if pageClass %} {{ pageClass }}{% endif %}">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-divider"></div>
    <div class="footer-content">
      <div class="footer-brand">
        <h3>Lunar Light Awakening</h3>
      </div>
      <div class="footer-contact">
        <p><a href="tel:7155817317">(715) 581-7317</a></p>
        <p><a href="mailto:lunarlightawakening@gmail.com">lunarlightawakening@gmail.com</a></p>
      </div>
      <div class="footer-address">
        <p>453 Grand Avenue, Suite B</p>
        <p>Schofield, WI 54476</p>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      const toggle = document.querySelector(".nav-toggle");
      const nav = document.getElementById("site-nav");
      if (!toggle || !nav) return;

      function setMenuOpen(open) {
        nav.classList.toggle("is-open", open);
        document.body.classList.toggle("nav-open", open);
        toggle.setAttribute("aria-expanded", String(open));
      }

      toggle.addEventListener("click", function () {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        setMenuOpen(!isOpen);
      });

      nav.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", function () {
          setMenuOpen(false);
        });
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && nav.classList.contains("is-open")) {
          setMenuOpen(false);
          toggle.focus();
        }
      });

      window.addEventListener("resize", function () {
        if (window.innerWidth > 768 && nav.classList.contains("is-open")) {
          setMenuOpen(false);
        }
      });
    })();

    (function () {
      const configs = [
        { gridSelector: ".events-grid", cardSelector: ".event-card", defaultGap: 14 },
        { gridSelector: ".practitioners-grid", cardSelector: ".practitioner-card", defaultGap: 32 },
      ];

      function layoutGrid(grid, cards, defaultGap) {
        if (window.innerWidth <= 768) {
          grid.classList.remove("is-masonry");
          cards.forEach(function (card) {
            card.style.gridRowEnd = "";
          });
          return;
        }

        grid.classList.add("is-masonry");
        const gap = parseFloat(getComputedStyle(grid).columnGap) || defaultGap;
        cards.forEach(function (card) {
          card.style.gridRowEnd = "";
        });
        cards.forEach(function (card) {
          const height = Math.ceil(card.getBoundingClientRect().height);
          card.style.gridRowEnd = "span " + Math.ceil(height + gap);
        });
      }

      const activeGrids = configs
        .map(function (cfg) {
          const grid = document.querySelector(cfg.gridSelector);
          if (!grid) return null;
          return {
            grid: grid,
            cards: Array.from(grid.querySelectorAll(cfg.cardSelector)),
            defaultGap: cfg.defaultGap,
          };
        })
        .filter(Boolean);

      if (!activeGrids.length) return;

      function layoutAll() {
        activeGrids.forEach(function (item) {
          layoutGrid(item.grid, item.cards, item.defaultGap);
        });
      }

      activeGrids.forEach(function (item) {
        item.grid.querySelectorAll("img").forEach(function (img) {
          if (!img.complete) {
            img.addEventListener("load", layoutAll);
          }
        });
      });

      window.addEventListener("load", layoutAll);
      window.addEventListener("resize", layoutAll);
      layoutAll();
    })();
  </script>

</body>
</html>
