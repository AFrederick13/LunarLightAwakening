<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Lunar Light Awakening") }}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <header class="site-header">
    <div class="logo-container">
      <a href="/">
        <img src="/images/LunaLandscape.jpg" alt="Lunar Light Awakening Logo" class="site-logo">
      </a>
    </div>

    <nav class="site-nav">
      <a href="/" class="{% if page.url == '/' %}active{% endif %}">Home</a>
      <a href="/merchandise/" class="{% if page.url == '/merchandise/' %}active{% endif %}">Merchandise</a>
      <a href="/events-and-classes/" class="{% if page.url == '/events-and-classes/' %}active{% endif %}">Events &amp; Classes</a>
      <a href="/practitioner-services/" class="{% if page.url == '/practitioner-services/' %}active{% endif %}">Practitioner Services</a>
      <a href="/blog/" class="{% if page.url == '/blog/' %}active{% endif %}">Blog</a>
    </nav>
  </header>

  <main class="site-main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-divider"></div>
    <div class="footer-content">
      <div class="footer-brand">
        <h3>Lunar Light Awakening</h3>
      </div>
      <div class="footer-contact">
        <p><a href="tel:7155817317">(715) 581-7317</a></p>
        <p><a href="mailto:lunarlightawakening@gmail.com">lunarlightawakening@gmail.com</a></p>
      </div>
      <div class="footer-address">
        <p>453 Grand Avenue, Suite B</p>
        <p>Schofield, WI 54476</p>
      </div>
    </div>
  </footer>

</body>
</html>
